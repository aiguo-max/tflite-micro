-}
-
 TfLiteStatus PadEval(TfLiteContext* context, TfLiteNode* node) {
   TFLITE_DCHECK(node->user_data != nullptr);
   const OpData* data = static_cast<const OpData*>(node->user_data);
@@ -96,7 +56,16 @@ TfLiteStatus PadEval(TfLiteContext* context, TfLiteNode* node) {
       }
     } break;
     case kTfLiteInt8: {
-      PadEvalInt8(context, node);
+      // Workaround: arm_pad_s8 crashes on x86 (CMSIS-NN V4.0.0).
+      // See: docs/workaround-cmsis-nn-pad-x86-crash.patch
+      int8_t pad_value =
+          constant_values == nullptr
+              ? static_cast<int8_t>(data->output_zero_point)
+              : *tflite::micro::GetTensorData<int8_t>(constant_values);
+      reference_ops::Pad(data->params, tflite::micro::GetTensorShape(input),
+                         tflite::micro::GetTensorData<int8_t>(input),
+                         &pad_value, tflite::micro::GetTensorShape(output),
+                         tflite::micro::GetTensorData<int8_t>(output));
     } break;
     case kTfLiteInt16: {
       int16_t pad_value =
@@ -138,8 +107,5 @@ TFLMRegistration Register_PADV2() {
   return tflite::micro::RegisterOp(PadInit, PadPrepare, PadEval);
 }
 
-TFLMRegistration Register_PAD_INT8() {
-  return tflite::micro::RegisterOp(PadInit, PadPrepare, PadEvalInt8);
-}
 
 }  // namespace tflite
